# Apify API Token — 用于抓取 TikTok 账号数据
# 获取: https://console.apify.com/account#/integrations
APIFY_API_TOKEN=your_apify_token_here

# TikHub API Key — 用于抓取 TikTok 话题/标签数据
# 获取: https://tikhub.io
TIKHUB_API_KEY=your_tikhub_key_here

# DeepSeek API Key — 用于 AI 数据分析
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_key_here

# 代理地址（可选，留空直连）
PROXY_URL=
